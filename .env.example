# OS environment overrides this file. Restart server after changing values.
# Default preset; the UI can switch without restarting.
DEPTH_ENGINE=yolo26
YOLO_MODEL=yolo26n-depth.pt
DA2_SMALL_MODEL=depth-anything/Depth-Anything-V2-Small-hf
DA3_SMALL_MODEL=depth-anything/DA3-SMALL
DA3_METRIC_MODEL=depth-anything/DA3METRIC-LARGE
# auto -> CUDA, then MPS, then CPU. Explicit unavailable device fails loudly.
DEPTH_DEVICE=auto
# YOLO only
DEPTH_IMGSZ=768
DEPTH_HALF=0
# V2 only: original relative model; p5/p95 -> virtual display depth 1..5, NOT meters.
# Size is the processor reference size, NOT necessarily the actual input long edge.
DA2_INPUT_SIZE=518
DA2_HALF=0
DA2_HF_REVISION=
# DA3 only: multiple of 14; auto=CUDA bf16/fp16 or CPU/MPS fp32
DA3_PROCESS_RES=504
DA3_PRECISION=auto
DA3_HF_REVISION=
# No model download in offline mode; configure local .pt / HF model directories.
MODEL_OFFLINE=0
# Original image prep / browser point sampling. TARGET_HZ is a cap, not a promise.
MAX_IMAGE_WIDTH=960
GRID_WIDTH=220
TARGET_HZ=2
# The example HFOV is not the user's camera calibration.
CAMERA_HFOV_DEG=65
CAMERA_INTRINSICS_FILE=
# YOLO / DA3Metric ONLY; outside interval -> discard, not clamp.
MIN_DEPTH_M=0.1
MAX_DEPTH_M=80
COLOR_MIN_M=0.1
COLOR_MAX_M=20
# V2 + DA3-Small relative bounds. V2 uses virtual 1..5; DA3 retains raw relative Z.
RELATIVE_MIN_DEPTH=0.000001
RELATIVE_MAX_DEPTH=1000000
# Confidence is NOT a probability; 0 disables it. Applies only when output exists.
DA3_CONF_PERCENTILE=0
DA3_EXCLUDE_SKY=1
RTSP_OPEN_TIMEOUT_MS=5000
RTSP_READ_TIMEOUT_MS=5000
RTSP_URL=
HOST=127.0.0.1
PORT=8000

# Explicit Host header allowlist. Add your server IP/name for a trusted LAN.
# This is not login/authentication; do not expose the service to the Internet.
DEPTHPORT_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# v0.2 optional YOLO semantic model (uses separate Detect/Segment weights)
SEMANTIC_DETECT_MODEL=yolo26n.pt
SEMANTIC_SEGMENT_MODEL=yolo26n-seg.pt
