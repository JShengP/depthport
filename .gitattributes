* text=auto
*.py text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.png binary

# Curated numeric packs are byte-hashed; preserve LF with Windows autocrlf.
website/data/**/*.json text eol=lf

# Frozen Node regression inputs must match their Git blob bytes on Windows.
*.cjs text eol=lf
docs/validation/windows-node-stability-plan.json text eol=lf
